#!/bin/sh
# The handbook's own pre-commit hook: one line of glue, because the mechanism it uses is a
# template it ships (templates/pre-commit-dispatch), and this repo is not exempt from its
# own handbook.
#
# It EXECS THE TEMPLATE rather than keeping a copy of it. That is the one thing an adopter
# must NOT do — copy-and-own means your hook is yours and nothing changes it under you — but
# here the template and the repo are the same repo, so a copy would be a second copy of a
# file already in this tree, free to drift from the source it was copied from. The hooklets
# in .githooks/pre-commit.d/ do the same where a template exists for them.
set -eu
root=$(git rev-parse --show-toplevel)
exec "$root/templates/pre-commit-dispatch" "$root/.githooks/pre-commit.d"
