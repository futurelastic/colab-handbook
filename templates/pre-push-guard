#!/bin/sh
# pre-push-guard — refuse raw `git push` to protected branches unless a sanctioned path set the env.
#   TRUNK (from .github/project.yml): allowed by COLAB_SHIP=1 (colab ship) or COLAB_HUMAN=1.
#   INTEGRATION lines (project.yml `integration:`): same rule as trunk. Work merges into a declared
#     line exactly the way it merges into trunk — via `colab ship` — so it gets the same door. The
#     line is a DEVELOPMENT integration point: guarding it protects the branch, and nothing here
#     gives it any path to production.
#   MAIN, on tier A and C (trunk != main): allowed by COLAB_PROMOTE=1 (colab promote) or COLAB_HUMAN=1.
#     COLAB_SHIP does NOT open main — ship is trunk/line-only by design.
#     The guard keys on `trunk != main`, never on the tier letter, so tier C is covered
#     automatically — main there is what promotion deploys, so it needs the gate most.
# On tier B (trunk == main) the trunk rule already covers main. Non-protected pushes always pass.
# Missing .github/project.yml → degrade to ALLOW (with a warning) rather than block work.
#
# The two variables named above are set BY A TOOL (`colab ship`, `colab promote`) or BY A PERSON at
# the keyboard — never by an agent reading this file or one of the refusals below. COLAB_SHIP is a
# process-identity assertion, not a permission: typed by hand it claims preconditions nothing ran.
# The refusal messages below therefore name the remedy and not the variable (#322) — this header is
# the documentation lane, which a human consults deliberately and an error message is not.
#
# Install (copy-and-own, per repo):
#   cp templates/pre-push-guard .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#   # or, if you use a shared hooks dir:  cp templates/pre-push-guard "$(git config core.hooksPath)/pre-push"
set -eu

root=$(git rev-parse --show-toplevel 2>/dev/null || echo .)
pj="$root/.github/project.yml"
if [ ! -f "$pj" ]; then
  echo "pre-push-guard: no .github/project.yml — allowing push (cannot determine trunk)." >&2
  exit 0
fi

trunk=$(sed -n 's/^trunk:[[:space:]]*//p' "$pj" | head -1 | tr -d "\"'" | awk '{print $1}')
[ -z "$trunk" ] && exit 0

# Declared integration lines, in either YAML list form: `integration: [a, b]` or `integration:`
# followed by `  - a` lines. Same minimal subset the audit tool and the CLI read.
integration=$(awk '
  /^integration:[[:space:]]*\[/ {
    s = $0; sub(/^[^[]*\[/, "", s); sub(/\].*$/, "", s); gsub(/[,"'"'"']/, " ", s); print s; next
  }
  /^integration:[[:space:]]*$/ { inlist = 1; next }
  inlist && /^[[:space:]]*-[[:space:]]*/ {
    s = $0; sub(/^[[:space:]]*-[[:space:]]*/, "", s); sub(/[[:space:]]*#.*$/, "", s)
    gsub(/["'"'"']/, "", s); print s; next
  }
  inlist && /^[^[:space:]#]/ { inlist = 0 }
' "$pj")

# Which protected refs are being pushed? (stdin: <localref> <localsha> <remoteref> <remotesha>)
pushing_trunk=0
pushing_main=0
pushing_line=""
while read -r _localref _localsha remoteref _remotesha; do
  case "${remoteref:-}" in
    refs/heads/"$trunk") pushing_trunk=1 ;;
    refs/heads/main)     pushing_main=1 ;;
  esac
  for line in $integration; do
    if [ "${remoteref:-}" = "refs/heads/$line" ]; then pushing_line="$line"; fi
  done
done

# A REFUSAL NAMES THE REMEDY, NEVER THE DOOR (#322). Each message below used to end with the
# environment variable that defeats it. That is a bypass printed at the exact moment its reader has
# run out of ideas, and it was taken: two independent sessions in one day set COLAB_SHIP=1 by hand
# after this hook refused them, one of them reporting it as ordinary housekeeping. Neither had read
# it in a skill — they read it HERE. So these messages say what to run; the attended-human override
# is documented in this file's header and in tools/README.md, where a person looks it up and an
# agent scanning an error message does not find it.
#
# COLAB_SHIP is a PROCESS-IDENTITY assertion — "`colab ship` ran its preconditions" — not a human
# gate. Typed by hand it asserts that falsely and skips the grade, the branch-CI check, the claim
# release and the evidence comment. There is no case where typing it is the right next step.

# The remote the remedy text below names (#376). git hands a pre-push hook the remote it is pushing
# to as $1 — the name when the push went through a configured remote, the bare URL when it did not.
# A name is used as-is: it is the remote this push actually targets, and the one whose tracking ref
# the reader has. A URL push has no tracking ref of its own, so it falls back to the per-clone
# override colab itself reads (`git config colab.remote`, tools/README.md "Which remote"), then to
# `origin`. Message-only: nothing below decides anything on this value.
remote=${1:-}
if [ -z "$remote" ] || ! git config --get "remote.$remote.url" >/dev/null 2>&1; then
  remote=$(git config --get colab.remote 2>/dev/null || true)
  [ -z "$remote" ] && remote=origin
fi

# TRUNK guard (also covers tier B, where trunk == main).
if [ "$pushing_trunk" -eq 1 ] && [ "${COLAB_SHIP:-}" != "1" ] && [ "${COLAB_HUMAN:-}" != "1" ]; then
  echo "pre-push-guard: refusing raw push to trunk '$trunk'." >&2
  echo "  Ship the branch instead:  colab ship --branch <your-branch>" >&2
  echo "  Already committed onto '$trunk' by hand? That commit belongs on a branch, not here:" >&2
  echo "    git log --oneline $remote/$trunk..$trunk        # what is actually there" >&2
  echo "    git branch <type>/<slug>-<issue> $trunk        # keep it, on a branch" >&2
  echo "    git reset --hard $remote/$trunk                 # return the checkout to at-rest" >&2
  echo "  then claim its issue and ship that branch." >&2
  exit 1
fi

# INTEGRATION-LINE guard — a declared long-lived line is an integration point, not a feature branch.
if [ -n "$pushing_line" ] && [ "${COLAB_SHIP:-}" != "1" ] && [ "${COLAB_HUMAN:-}" != "1" ]; then
  echo "pre-push-guard: refusing raw push to integration line '$pushing_line'." >&2
  echo "  Ship the branch instead (it merges into the base the branch was cut from):" >&2
  echo "    colab ship --branch <your-branch>" >&2
  exit 1
fi

# MAIN guard — only on tier A and C (trunk != main). COLAB_SHIP intentionally does NOT open main.
if [ "$trunk" != "main" ] && [ "$pushing_main" -eq 1 ] && [ "${COLAB_PROMOTE:-}" != "1" ] && [ "${COLAB_HUMAN:-}" != "1" ]; then
  echo "pre-push-guard: refusing raw push to 'main' (promotion target)." >&2
  echo "  Promotion is trunk->main and it is a human act on every repo:  colab promote" >&2
  echo "  There is no agent-side override for this one; if you are an agent, this is where you stop" >&2
  echo "  and report, not where you look for a flag." >&2
  exit 1
fi

exit 0
